        "rules": [
          {
            "name": "Professional Butcher",
            "id": "2f67-a874-3e1d-707b",
            "description": "If a flabflighter incapacitates an enemy during a Fight action, it may immediately perform another, free Fight action. If this incapacitates another enemy, the flabfighter may perform another free Fight action, and so on until it fails to incapacitate an enemy or there are no more enemies close enough to fight!",
            "hidden": false,
            "page": 37,
            "publicationId": "4353-a3c6-7b4d-0185"
          }
