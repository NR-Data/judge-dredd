    "sharedRules": [
      {
        "name": "Jet Barf",
        "id": "676f-951a-3768-da02",
        "description": "Once per game, a Fattie with this rule may perform an Aimed Fire double-action to spray nearby enemies with a concentrated stream of corrosive vomit!\nAll models caught within the blast will be automatically pinned unless successfully dodged.",
        "hidden": false
      },
      {
        "name": "Wall of Flub!",
        "id": "e899-38cb-91ab-c28a",
        "description": "When making a Charge roll use 2D6 but do not add the model's Move.\n-The Fattie must move the full distance rolled.\n-If a Fattie moves in to close combat range (1\") of a target it makes a close combat attack with a bonus of +2 to its Fight.\n-Target model gains +1 to Evade Dodge, whatever the result of the attack the target is diplaced 1\" out of the Fattie's path.",
        "hidden": false
      }
    ],
