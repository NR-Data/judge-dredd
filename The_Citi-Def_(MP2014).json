            "rules": [
              {
                "name": "Medi-kit",
                "id": "a4c7-53ec-8e6c-81bc",
                "description": "A model with a medi-kit may attempt to resuscitate one other model that loses its last Hit for every Special action it has taken in its last Phase. If a model is killed within a range equal to the Move score of the medi-kit carrier, you may move the medic to the model’s side and make an Agility check. If successful, the ‘dead’ model is immediately returned to its feet with a single Hit and may carry on taking actions in its next Phase. Medi-Kits may not be used on robots, zombies, demons, or aliens.",
                "hidden": false
              }
            ]
          },
