          {
            "name": "Mech.Mk1 ",
            "id": "ed90-381c-b4fb-e445",
            "hidden": false,
            "infoLinks": [{"name": "Robot", "id": "6edf-68ce-0f4c-8021", "hidden": false, "targetId": "77fa-9473-9b8f-9902", "type": "rule"}],
            "rules": [
              {
                "name": "Self-Repair Sub-Routines",
                "id": "32a2-c166-affd-cc02",
                "description": "If it is injured and uses the Hunked Down double-action, it can potentially remove all Injury markers if enough successes are rolled.",
                "hidden": false
              },
              {
                "name": "Respect the Machine Law",
                "id": "f539-69d9-532e-7258",
                "description": "Whenever a Mechanismo Mk1 activates they can immediatly aattemt to intimidate all opposing models that are within line of sight and within 8\" range of the Mechanismo, withouth using an action.\nMake a Cool test:\n[Special]= One model Pinned per result.",
                "hidden": false
              },
              {
                "name": "Shut Down Number 5!",
                "id": "61c3-f780-6725-9892",
                "description": "When activated by using a Star chip or making a double-action, make a Cool test at the end of the models activation.\nIf the Cool test is failed the opposing player may immediately activate the Mechanismo Mk1 and perform up to:\nOne single action or one double-action\nThen may target any model within range and line of sight.\nAfter the activation is complete, the Mechanismo Mk1 is Stunned and control returns to the origional owner.",
                "hidden": false
              }
            ]
          }
        ],
