        "infoGroups": [
          {
            "name": "Sky Raider Pack Leader Info",
            "id": "7541-fd2b-e18a-a52d",
            "hidden": false,
            "rules": [
              {
                "name": "Scary Mutant",
                "id": "7f03-43c4-d6fd-f293",
                "description": "Models other than Judges suffer -1 on any tests made against their Cool stat when they are within 4\" of the Mutie.",
                "hidden": false
              },
              {
                "name": "Mutie Insight",
                "id": "447d-727a-676c-87b4",
                "description": "If a Sky Raider Pack Leader is the leader of your faction when Big Meg cards are drawn, you draw one extra Big Meg card and can keep one more card than normal.",
                "hidden": false
              },
              {
                "name": "Take That, Norms!",
                "id": "01d9-3d3d-3bd1-233d",
                "description": "When the Sky Raider Pack Leader activates, they can use a single action to remove D3 Action chips from any Sky Raiders within 6\" and return those chips to the bag.",
                "hidden": false
              }
            ]
          }
        ],
