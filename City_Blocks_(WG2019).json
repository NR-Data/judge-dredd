        "rules": [
          {
            "name": "Improvisation",
            "id": "677d-f10e-bfd5-0e59",
            "description": "Every turn, one model in every 10 (or part of) within a Resident Mob Pack can use one of the following weapons: Chain, Hand Bomb (Incendiary, Hi-Ex or Smoke), Hand Cannon, Laz Saw, Sawn-off Stump Gun, or Spit Pistol.",
            "hidden": false,
            "page": 35,
            "publicationId": "4353-a3c6-7b4d-0185"
          },
          {
            "name": "Pack (6+)",
            "id": "a05e-b7ba-c6b1-3ec5",
            "description": "Resident Mobs can be of any size - limited only by the amount of Notoriety spent on them! However, they must contain at least six models. They follow the Pack rules detailed on page 19 of the Judge Dredd Miniatures Game. If the Pack drops to fewer than five models it immediately becomes subject to the Apt to Panic and Fear the Law rules on page 91 of the Judge Dredd Miniatures Game.",
            "hidden": false,
            "page": 35,
            "publicationId": "4353-a3c6-7b4d-0185"
          }
        ],
