          {
            "name": "Rally Blockers",
            "id": "0fa9-3f61-b9dd-14a7",
            "description": "At the start of the turn, the block Champion may combine any Resident Mob models within 12\" into a new or existing Resident Mob Pack. In addition, the Block Champion can convert any Average Citizens (JGMG p91) into Resident Mob  models and then combine them into a new or existing Pack.",
            "hidden": false
          },
          {
            "name": "True Inspiration",
            "id": "32b8-3b67-1502-8e7a",
            "description": "Any Resident Mob Pack within 6\" of the Block Champion can re-roll any Combat dice roll it makes.",
            "hidden": false
          }
        ],
