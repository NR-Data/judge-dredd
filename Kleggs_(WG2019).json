        ],
        "rules": [
          {
            "name": "\"Klegg-Hai!\"",
            "id": "db98-369b-1e80-2315",
            "description": "A faction containing Klegg mercenaries may choose the \"Klegg-Hai!\" card as one of its Big Meg card selections.",
            "hidden": false,
            "page": 79,
            "publicationId": "4353-a3c6-7b4d-0185"
          },
          {
            "name": "Meatseeker",
            "id": "a284-8e69-d628-84f9",
            "description": "-Any non-Klegg character declaring a Fight or Charge action against a Klegg character must perform a Cool test. If the test is passed, the character may continue with their action. If the test is failed, the character will not perform the Fight or Charge action and their turn is considered over - the Action chip is placed next to the character.\n-If the action was triggered by a Star chip, the character may follow the rules for Going for Broke and potentially perform additional actions.",
            "hidden": false,
            "page": 79,
            "publicationId": "4353-a3c6-7b4d-0185"
          },
          {
            "name": "Slicey Slicey, Oncey Twicey...",
            "id": "ddab-b77e-ef70-1da4",
            "description": "If a Klegg smells edible prey nothing short of having its head blown off will stop its pursuit of food. A Klegg cannot be pinned and will suffer no Cool stat loss for injury or stun results.",
            "hidden": false,
            "page": 79,
            "publicationId": "4353-a3c6-7b4d-0185"
          }
        ],
